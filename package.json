{
  "name": "dsh-multivers",
  "version": "1.0.0",
  "description": "MULTIVERS engine for DeepSeek Harness: Zero-Bloat Payload Diet, Context Synthesizer, Flatline Rolling Window, and Settings Dashboard.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multivers",
    "context-window",
    "rate-limit-fix",
    "sliding-window",
    "token-pruner"
  ],
  "author": "Aydin04",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aydin04/dsh-multivers.git"
  }
}